# LLM Provider Configuration
# Choose: "ollama" or "openai"
LLM_PROVIDER=ollama

# OpenAI Configuration (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=username
NEO4J_PASSWORD=password

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Application Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=gpt-4-turbo-preview
TEMPERATURE=0.7
MAX_TOKENS=2000

# Retrieval Settings
TOP_K_VECTOR=5
TOP_K_BM25=5
TOP_K_GRAPH=3
FINAL_TOP_K=10

# HITL Re-ranking Configuration
HITL_BOOST_FACTOR=2.0
HITL_DECAY_FACTOR=0.95
